{
  "name": "im-better",
  "productName": "I'm Better!",
  "version": "0.1.0",
  "description": "A small hand-drawn game about jealousy.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.imbetter.game",
    "productName": "I'm Better",
    "files": [
      "index.html",
      "css/**",
      "src/**",
      "assets/**",
      "electron/**"
    ],
    "win": {
      "target": "dir"
    }
  }
}
